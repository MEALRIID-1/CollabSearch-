APP_NAME=CollabSearch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=collabsearch
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

FRONTEND_URL=http://localhost:3000

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@collabsearch.com"
MAIL_FROM_NAME="${APP_NAME}"

# Jitsi Meet — Visioconférence
JITSI_APP_ID=collabsearch
JITSI_APP_SECRET=votre_secret_fort_ici
JITSI_SERVER_URL=https://meet.jit.si
JITSI_WEBHOOK_SECRET=
JITSI_JWT_EXPIRATION=3600

# ============================================================
# IA — Fournisseurs gratuits recommandés
# ============================================================
# AI_PROVIDER accepte : groq | gemini | claude | openai | ollama
# Cascade automatique si provider non défini : Groq → Claude → Gemini → OpenAI → Mock

AI_PROVIDER=groq
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# GROQ (GRATUIT — 14 400 req/jour) — https://console.groq.com
# Modèle : llama-3.3-70b-versatile (très performant, ultra-rapide)
GROQ_API_KEY=

# GOOGLE GEMINI (GRATUIT — 1 500 req/jour) — https://aistudio.google.com
# Modèle : gemini-1.5-flash
GEMINI_API_KEY=

# ANTHROPIC CLAUDE (payant) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OPENAI (payant) — https://platform.openai.com
OPENAI_API_KEY=

# ============================================================
# RECHERCHE WEB — APIs gratuites
# ============================================================
# SERPER.DEV (GRATUIT — 2 500 req/mois) — https://serper.dev
SERPER_API_KEY=

# TAVILY (GRATUIT — 1 000 req/mois, conçu pour l'IA) — https://app.tavily.com
TAVILY_API_KEY=
